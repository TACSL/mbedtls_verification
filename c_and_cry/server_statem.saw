let new_session_ticket_spec f_ticket_write = do{
    // (s,conn) <- distinctive_setup_spec f_ticket_write {{ True }} {{ True }} {{ True }};

    (s,conn) <- setup_struct f_ticket_write {{ True }} {{ True }} {{ True }} {{ (0:[32]) }} {{ (0:[32]) }} {{ False }};

    llvm_execute_func [s];

    let conn' = {{ssl_tls13_write_new_session_ticket conn}};

    llvm_points_to (llvm_field s "state") (llvm_term {{conn'.1.state}});
    llvm_return (llvm_term {{conn'.0}});
};

let handshake_server_step_spec f_ticket_write hflag pflag ms eds= do{
    // (s,conn) <- distinctive_setup_spec f_ticket_write hflag {{ True }} pflag;
    (s,conn) <- setup_struct f_ticket_write hflag {{ True }} pflag ms eds {{True}};

    llvm_alloc_global "mr";
    r <- llvm_fresh_var "r" (llvm_int 32);
    llvm_points_to (llvm_global "mr") (llvm_term r);

    llvm_alloc_global "non_empty";
    ne <- llvm_fresh_var "ne" (llvm_int 32);
    llvm_points_to (llvm_global "non_empty") (llvm_term ne);
    llvm_precond {{ ne == (0:[32]) \/ ne == (1:[32]) }};

    llvm_alloc_global "pick_key";
    pk <- llvm_fresh_var "pk" (llvm_int 32);
    llvm_points_to (llvm_global "pick_key") (llvm_term pk);

    llvm_execute_func [s];

    let conn' = {{mbedtls_ssl_tls13_handshake_server_step conn r pk ne}};

    llvm_points_to (llvm_field s "state") (llvm_term {{conn'.1.state}});
    llvm_return (llvm_term {{conn'.0}});
};

// llvm_verify sllvm "mbedtls_ssl_tls13_handshake_server_step" [] false (handshake_server_step_spec {{ (0:[32]) }} {{False}} {{ True }}) yices;

let run_handshake_server_step_spec hflag ms eds= do{
    print (str_concats ["Handshake null?:", show hflag, " -State: ", show ms, " -EDS:", show eds]);
    if eval_bool {{ ms == MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET }} then
        do {
            llvm_verify sllvm "mbedtls_ssl_tls13_handshake_server_step" [] false (handshake_server_step_spec {{ (0:[32]) }} hflag {{ True }} ms eds) (w4_unint_yices[]);
            llvm_verify sllvm "mbedtls_ssl_tls13_handshake_server_step" [] false (handshake_server_step_spec {{ (1:[32]) }} hflag {{ True }} ms eds) (w4_unint_yices[]);
        }
    else if eval_bool {{ ms== MBEDTLS_SSL_CLIENT_CERTIFICATE}} then
        do {
            llvm_verify sllvm "mbedtls_ssl_tls13_handshake_server_step" [] false (handshake_server_step_spec {{ (0:[32]) }} hflag {{ True }} ms eds) (w4_unint_yices[]);
            llvm_verify sllvm "mbedtls_ssl_tls13_handshake_server_step" [] false (handshake_server_step_spec {{ (0:[32]) }} hflag {{ False }} ms eds) (w4_unint_yices[]);
        }
    else
       llvm_verify sllvm "mbedtls_ssl_tls13_handshake_server_step" [] false (handshake_server_step_spec {{ (0:[32]) }} hflag {{ True }} ms eds) (w4_unint_yices[]);

};

llvm_verify sllvm "ssl_tls13_process_client_hello" [] false client_hello_spec yices;
llvm_verify sllvm "ssl_tls13_write_hello_retry_request" [] false hello_retry_request_spec yices;
llvm_verify sllvm "ssl_tls13_write_server_hello" [] false server_hello_spec yices;
llvm_verify sllvm "ssl_tls13_write_encrypted_extensions" [] false encrypted_extensions_spec yices;
llvm_verify sllvm "ssl_tls13_write_certificate_request" [] false certificate_request_spec yices;
llvm_verify sllvm "ssl_tls13_write_server_certificate" [] false server_certificate_spec yices;
llvm_verify sllvm "ssl_tls13_write_certificate_verify" [] false certificate_verify_spec yices;
llvm_verify sllvm "mbedtls_ssl_tls13_write_change_cipher_spec" [] false change_cipher_spec_spec yices;
llvm_verify sllvm "ssl_tls13_write_server_finished" [] false server_finished_spec (w4_unint_yices[]);
llvm_verify sllvm "ssl_tls13_process_client_finished" [] false client_finished_spec yices;
llvm_verify sllvm "ssl_tls13_handshake_wrapup" [] false handshake_wrapup_spec yices;
llvm_verify sllvm "mbedtls_ssl_tls13_process_certificate" [] false process_certificate_spec yices;
llvm_verify sllvm "mbedtls_ssl_tls13_process_certificate_verify" [] false process_certificate_verify_spec yices;
llvm_verify sllvm "ssl_tls13_write_new_session_ticket" [] false (new_session_ticket_spec {{0:[32]}}) yices;
llvm_verify sllvm "ssl_tls13_write_new_session_ticket" [] false (new_session_ticket_spec {{1:[32]}}) yices;
print "Sub-functions have been proven.";
print"---------------";

for [0,1] (\hflag ->
    for mbedtls_state (\ms -> 
        for early_data_states (\eds -> 
            run_handshake_server_step_spec hflag ms eds)));
            
print "DONE";