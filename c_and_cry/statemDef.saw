enable_deprecated;
enable_experimental;
enable_lax_loads_and_stores;
import "..//cry//Def.cry";
cllvm <- llvm_load_module "client_statem.bc"; //ssl_tls+client+tls13client+generic
sllvm <- llvm_load_module "server_statem.bc"; //ssl_tls+tls13server+generic

let mbedtls_state = [
    {{MBEDTLS_SSL_HELLO_REQUEST}},
    {{MBEDTLS_SSL_CLIENT_HELLO}},
    {{MBEDTLS_SSL_SERVER_HELLO}},
    {{MBEDTLS_SSL_SERVER_CERTIFICATE}},
    {{MBEDTLS_SSL_SERVER_KEY_EXCHANGE}},
    {{MBEDTLS_SSL_CERTIFICATE_REQUEST}},
    {{MBEDTLS_SSL_SERVER_HELLO_DONE}},
    {{MBEDTLS_SSL_CLIENT_CERTIFICATE}},
    {{MBEDTLS_SSL_CLIENT_KEY_EXCHANGE}},
    {{MBEDTLS_SSL_CERTIFICATE_VERIFY}},
    {{MBEDTLS_SSL_CLIENT_CHANGE_CIPHER_SPEC}},
    {{MBEDTLS_SSL_CLIENT_FINISHED}},
    {{MBEDTLS_SSL_SERVER_CHANGE_CIPHER_SPEC}},
    {{MBEDTLS_SSL_SERVER_FINISHED}},
    {{MBEDTLS_SSL_FLUSH_BUFFERS}},
    {{MBEDTLS_SSL_HANDSHAKE_WRAPUP}},
    {{MBEDTLS_SSL_NEW_SESSION_TICKET}},
    {{MBEDTLS_SSL_SERVER_HELLO_VERIFY_REQUEST_SENT}},
    {{MBEDTLS_SSL_HELLO_RETRY_REQUEST}},
    {{MBEDTLS_SSL_ENCRYPTED_EXTENSIONS}},
    {{MBEDTLS_SSL_END_OF_EARLY_DATA}},
    {{MBEDTLS_SSL_CLIENT_CERTIFICATE_VERIFY}},
    {{MBEDTLS_SSL_CLIENT_CCS_AFTER_SERVER_FINISHED}},
    {{MBEDTLS_SSL_CLIENT_CCS_BEFORE_2ND_CLIENT_HELLO}},
    {{MBEDTLS_SSL_SERVER_CCS_AFTER_SERVER_HELLO}},
    {{MBEDTLS_SSL_CLIENT_CCS_AFTER_CLIENT_HELLO}},
    {{MBEDTLS_SSL_SERVER_CCS_AFTER_HELLO_RETRY_REQUEST}},
    {{MBEDTLS_SSL_HANDSHAKE_OVER}},
    {{MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET}},
    {{MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET_FLUSH}}
]; 

let early_data_states = [
    {{MBEDTLS_SSL_EARLY_DATA_STATE_IDLE}},
    {{MBEDTLS_SSL_EARLY_DATA_STATE_NO_IND_SENT}},
    {{MBEDTLS_SSL_EARLY_DATA_STATE_IND_SENT}},
    {{MBEDTLS_SSL_EARLY_DATA_STATE_CAN_WRITE}},
    {{MBEDTLS_SSL_EARLY_DATA_STATE_ACCEPTED}},
    {{MBEDTLS_SSL_EARLY_DATA_STATE_REJECTED}},
    {{MBEDTLS_SSL_EARLY_DATA_STATE_SERVER_FINISHED_RECEIVED}}
];

let setup_struct f_ticket_write hflag cflag pflag ms eds aflag = do{
    // crylll <- setup_cry f_ticket_write hflag cflag pflag;

    s <- llvm_alloc (llvm_struct "struct.mbedtls_ssl_context");

    if eval_bool {{ aflag == 0 }}
      then do {
        /* state */
        mbed_state <- llvm_fresh_var "state" (llvm_int 32);
        llvm_precond {{ mbed_state >= (0:[32]) /\ mbed_state <= (29:[32]) }};
        llvm_points_to (llvm_field s "state") (llvm_term mbed_state);
        /* early_data_state */
        mbed_eds <- llvm_fresh_var "early_data_state" (llvm_int 32);
        llvm_precond {{ mbed_eds >= (0:[32]) /\ mbed_eds <= (6:[32]) }};
        llvm_points_to (llvm_field s "early_data_state") (llvm_term mbed_eds);
        let {{ c_mbed_state = mbed_state }};
        let {{ c_mbed_eds = mbed_eds }};
        // let {{ c_mbed_eds = 0 }};
        return ();
      }
    else do{
      let mbed_state = llvm_term {{ ms }};
      llvm_points_to (llvm_field s "state") mbed_state;

      let mbed_eds = llvm_term {{ eds }};
      llvm_points_to (llvm_field s "early_data_state") mbed_eds;

      let {{ c_mbed_state = ms }};
      let {{ c_mbed_eds = eds }};
      // let {{ c_mbed_eds = 0 }};
      return ();
    };

    tls_version <- llvm_fresh_var "tls_version" (llvm_int 32);
    llvm_precond {{ tls_version == (0:[32]) \/ tls_version == 0x00000303 \/ tls_version == 0x00000304 }};
    llvm_points_to (llvm_field s "tls_version") (llvm_term tls_version);

    /* handshake */
    // If there is an error "Expected a type named 'hflag' but found a value instead," 
    // then change `hflag to hflag.
    if eval_bool {{ hflag == 0 }}
      then do {
        llvm_points_to (llvm_field s "handshake") llvm_null;
        let {{ hs_cry = {
                        min_tls_version = 0,
                        hello_retry_request_flag = 0,
                        key_exchange_mode = 0,
                        client_auth = 0,
                        ccs_sent = 0,
                        certificate_request_sent = 0,
                        tls13_kex_modes = 0,
                        new_session_tickets_count = 0,
                        received_extensions = 0,
                        early_data_accepted = 0} }};
        return ();
      }
      else do { 
        handshake <- llvm_alloc (llvm_struct "struct.mbedtls_ssl_handshake_params");
        llvm_points_to (llvm_field s "handshake") handshake;

        min_tls_version <- llvm_fresh_var "min_tls_version" (llvm_int 32);
        llvm_precond {{ min_tls_version == (0:[32]) \/ min_tls_version == 0x00000303 \/ min_tls_version == 0x00000304 }};

        hello_retry_request_flag <- llvm_fresh_var "hello_retry_request_flag" (llvm_int 8);
        key_exchange_mode <- llvm_fresh_var "key_exchange_mode" (llvm_int 8);
        client_auth <- llvm_fresh_var "client_auth" (llvm_int 8);
        ccs_sent <- llvm_fresh_var "ccs_sent" (llvm_int 8);
        certificate_request_sent <- llvm_fresh_var "certificate_request_sent" (llvm_int 8);
        tls13_kex_modes1 <- llvm_fresh_var "tls13_kex_modes1" (llvm_int 8);
        new_session_tickets_count <- llvm_fresh_var "new_session_tickets_count" (llvm_int 16);
        received_extensions <- llvm_fresh_var "received_extensions" (llvm_int 32);
        early_data_accepted <- llvm_fresh_var "early_data_accepted" (llvm_int 8);

        llvm_points_to (llvm_field handshake "min_tls_version") (llvm_term min_tls_version);
        llvm_points_to (llvm_field handshake "hello_retry_request_flag") (llvm_term hello_retry_request_flag);
        llvm_points_to (llvm_field handshake "key_exchange_mode") (llvm_term key_exchange_mode);
        llvm_points_to (llvm_field handshake "client_auth") (llvm_term client_auth);
        llvm_points_to (llvm_field handshake "ccs_sent") (llvm_term ccs_sent);
        llvm_points_to (llvm_field handshake "certificate_request_sent") (llvm_term certificate_request_sent);
        llvm_points_to (llvm_field handshake "tls13_kex_modes") (llvm_term tls13_kex_modes1);
        llvm_points_to (llvm_field handshake "new_session_tickets_count") (llvm_term new_session_tickets_count);
        llvm_points_to (llvm_field handshake "received_extensions") (llvm_term received_extensions);
        llvm_points_to (llvm_field handshake "early_data_accepted") (llvm_term early_data_accepted);
        // llvm_points_to (llvm_field (llvm_field s "handshake") "early_data_accepted") (llvm_term early_data_accepted);

        let {{ hs_cry = {min_tls_version = min_tls_version,
                        hello_retry_request_flag = hello_retry_request_flag,
                        key_exchange_mode = key_exchange_mode,
                        client_auth = client_auth,
                        ccs_sent = ccs_sent,
                        certificate_request_sent = certificate_request_sent,
                        tls13_kex_modes = tls13_kex_modes1,
                        new_session_tickets_count = new_session_tickets_count,
                        received_extensions = received_extensions,
                        early_data_accepted = early_data_accepted
                        } }};
        return ();
      };

    /* conf */
    if eval_bool {{ cflag == 0 }}
      then do{
        llvm_points_to (llvm_field s "conf") llvm_null;
        let {{ c_cry = {tls13_kex_modes = 0,
                min_tls_version = 0,
                max_tls_version = 0,
                f_ticket_write = 0,
                new_session_tickets_count = 0,
                endpoint = 0} }};
        return ();
      }
      else do { 
        conf <- llvm_alloc (llvm_struct "struct.mbedtls_ssl_config");
        llvm_points_to (llvm_field s "conf") conf;
        new_session_tickets_count1 <- llvm_fresh_var "new_session_tickets_count1" (llvm_int 16);
        tls13_kex_modes <- llvm_fresh_var "tls13_kex_modes" (llvm_int 32);
        min_tls_version1 <- llvm_fresh_var "min_tls_version1" (llvm_int 32);
        llvm_precond {{ min_tls_version1 == (0:[32]) \/ min_tls_version1 == 0x00000303 \/ min_tls_version1 == 0x00000304 }};
        max_tls_version <- llvm_fresh_var "max_tls_version" (llvm_int 32);
        llvm_precond {{ max_tls_version == (0:[32]) \/ max_tls_version == 0x00000303 \/ max_tls_version == 0x00000304 }};
        endpoint <- llvm_fresh_var "endpoint" (llvm_int 8);

        llvm_points_to (llvm_field conf "tls13_kex_modes") (llvm_term tls13_kex_modes);
        llvm_points_to (llvm_field conf "min_tls_version") (llvm_term min_tls_version1);
        llvm_points_to (llvm_field conf "max_tls_version") (llvm_term max_tls_version);
        llvm_points_to (llvm_field conf "new_session_tickets_count") (llvm_term new_session_tickets_count1);
        llvm_points_to (llvm_field conf "endpoint") (llvm_term endpoint);

        if eval_bool {{ f_ticket_write == (0:[32]) }}
            then llvm_points_to (llvm_field conf "f_ticket_write") llvm_null
            else do { f_ticket_write <- llvm_alloc (llvm_int 32);
                        llvm_points_to (llvm_field conf "f_ticket_write") f_ticket_write;
                    };
        let {{ c_cry = {tls13_kex_modes = tls13_kex_modes,
                          min_tls_version = min_tls_version1,
                          max_tls_version = max_tls_version,
                          f_ticket_write = f_ticket_write,
                          new_session_tickets_count = new_session_tickets_count1,
                          endpoint = endpoint} }};
        return ();
      };

    session_negotiate <- llvm_alloc (llvm_struct "struct.mbedtls_ssl_session");
    llvm_points_to (llvm_field s "session_negotiate") session_negotiate;
    if eval_bool {{ pflag == 0 }}
      then llvm_points_to (llvm_field session_negotiate "peer_cert") llvm_null
      else do { 
        peer_cert <- llvm_alloc (llvm_struct "struct.mbedtls_x509_crt");
        llvm_points_to (llvm_field session_negotiate "peer_cert") peer_cert;};
    
    return (s, {{ {
                  state = c_mbed_state,
                  early_data_state = c_mbed_eds,
                  tls_version = tls_version,
                  handshake = hs_cry,
                  conf = c_cry,
                  null_flag = {handshake_flag = hflag,
                              conf_flag = cflag,
                              peer_cert_flag = pflag}
                  }
                }});
};

let setup_spec = do{
  d <- setup_struct {{ (0:[32]) }} {{ True }} {{ True }} {{ True }} {{ (0:[32]) }} {{ (0:[32]) }} {{ False }}; 
  return d;
};

let setup_step_spec ms eds = do{
  d <- setup_struct {{ (0:[32]) }} {{ True }} {{ True }} {{ True }} ms eds {{ True }}; 
  return d;
};