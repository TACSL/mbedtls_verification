
include "statemDef.saw";
import "..//cry//client_statem.cry";

let client_hello_spec = do{
    (s,conn) <- setup_spec;
    llvm_execute_func [s];

    let conn' = {{mbedtls_ssl_write_client_hello conn}};

    llvm_points_to (llvm_field s "state") (llvm_term {{conn'.1.state}});
    llvm_return (llvm_term {{conn'.0}});
};

let server_hello_spec = do{
    (s,conn) <- setup_spec;

    llvm_alloc_global "mr";
    r <- llvm_fresh_var "r" (llvm_int 32);
    llvm_points_to (llvm_global "mr") (llvm_term r);

    llvm_execute_func [s];

    let conn' = {{ssl_tls13_process_server_hello conn r}};

    llvm_points_to (llvm_field s "state") (llvm_term {{conn'.1.state}});
    llvm_return (llvm_term {{conn'.0}});
};

