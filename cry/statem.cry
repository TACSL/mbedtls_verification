module statem where

import CLib
import StructDef
import Config
import server_statem
import client_statem

type TLSTuple = {
    cur_state   : MBEDTLS_SSL_STATES,
    next_state  : MBEDTLS_SSL_STATES,
    sender      : [32]
}

mbedtls_ssl_handshake_step : SSL -> [32] -> [32] -> [32] -> ([32], SSL)
mbedtls_ssl_handshake_step s mr pick_key non_empty =
                        if s.null_flag.conf_flag == False \/ s.null_flag.handshake_flag == False \/ s.state == MBEDTLS_SSL_HANDSHAKE_OVER
                            then (MBEDTLS_ERR_SSL_BAD_INPUT_DATA, s)
                        else if MBEDTLS_SSL_CLI_C == True /\ s.conf.endpoint == MBEDTLS_SSL_IS_CLIENT
                            then ((mbedtls_ssl_tls13_handshake_client_step s mr non_empty).0, (mbedtls_ssl_tls13_handshake_client_step s mr non_empty).1)
                        else if MBEDTLS_SSL_SRV_C == True /\ s.conf.endpoint == MBEDTLS_SSL_IS_SERVER
                            then ((mbedtls_ssl_tls13_handshake_server_step s mr pick_key non_empty).0, (mbedtls_ssl_tls13_handshake_server_step s mr pick_key non_empty).1)
                        else (MBEDTLS_ERR_SSL_BAD_INPUT_DATA, s)

mbedtls_ssl_handshake : SSL -> [32] -> [32] -> [32] -> [15]MBEDTLS_SSL_STATES
mbedtls_ssl_handshake s mr pick_key non_empty = take`{15}mSSL.state
    where 
        mSSL = [s] # [if m.state != MBEDTLS_SSL_HANDSHAKE_OVER /\ (mbedtls_ssl_handshake_step m mr pick_key non_empty).0 == 0 
                        then (mbedtls_ssl_handshake_step m mr pick_key non_empty).1 
                    //   else if (mbedtls_ssl_handshake_step m mr pick_key non_empty).0 != 0
                    //     then errSSL
                      else m 
                      | m <- mSSL]

MR = 0
SS = {
        state = 20,
        early_data_state = 0,
        tls_version = 0,
        handshake = {min_tls_version = 0,
                    hello_retry_request_flag = 0,
                    key_exchange_mode = 0,
                    client_auth = 0,
                    ccs_sent = 0,
                    certificate_request_sent = 0,
                    tls13_kex_modes = 0,
                    new_session_tickets_count = 0,
                    received_extensions = 0,
                    early_data_accepted = 0},
        conf = {tls13_kex_modes = 0,
                min_tls_version = 0,
                max_tls_version = MBEDTLS_SSL_VERSION_TLS1_3,
                f_ticket_write = 0,
                new_session_tickets_count = 0,
                endpoint = 1},
        null_flag = {handshake_flag = 1,
                     conf_flag = 1,
                     peer_cert_flag = 1}
}