//configuration

let run_server_handshake x = do{
    // print "Current configuration is: ";
    // print {{ num2mbedc `x}};
    print (str_concats ["mbedstatem[", show x, "]= "]);
    print {{ (mbedtls_ssl_handshake`{NUM} (num2mbeds`{NUM} `x)).state }};
    print (str_concats ["RFCstatem[", show x, "]= "]);
    print {{ (stateMachine `{NUM} (num2RFCs `x)).cur_id }};
};

for xs (\x -> run_server_handshake (eval_int x));
