module valid_server_statem where

import Def
import conf

ssl_tls13_process_client_hello : SSL -> [32] -> ([32], SSL)
ssl_tls13_process_client_hello s mr = (ret, s2)
    where s2 = {state = state' ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = s.handshake,
                conf = s.conf,
                null_flag = s.null_flag
                }
          ret' = mr
          parse_client_hello_ret = ret'
          (ret, state') = if parse_client_hello_ret == SSL_CLIENT_HELLO_OK //0
                                then (0, MBEDTLS_SSL_SERVER_HELLO)
                          else (0, MBEDTLS_SSL_HELLO_RETRY_REQUEST) //if 1


ssl_tls13_write_hello_retry_request : (SSL, OT_CONF) -> [32] -> ([32], SSL)
ssl_tls13_write_hello_retry_request (s,ot) mr = (ret,s2)
    where s2 = {state = state' ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = {min_tls_version = s.handshake.min_tls_version,
                             hello_retry_request_flag = hello_retry_request_flag',
                             key_exchange_mode = s.handshake.key_exchange_mode,
                             client_auth = s.handshake.client_auth,
                             ccs_sent = s.handshake.ccs_sent,
                             certificate_request_sent = s.handshake.certificate_request_sent,
                             tls13_kex_modes = s.handshake.tls13_kex_modes,
                             new_session_tickets_count = s.handshake.new_session_tickets_count,
                             received_extensions = s.handshake.received_extensions,
                             early_data_accepted = s.handshake.early_data_accepted
                             },
                conf = s.conf,
                null_flag = s.null_flag
                }
          ret' = mr
          (ret, state', hello_retry_request_flag') = 
                          if ret' != 0 then (ret', s.state, s.handshake.hello_retry_request_flag)
                          else (
                            if ot.mbedtls_ssl_tls1_3_compatibility_mode == True
                                then (0, MBEDTLS_SSL_SERVER_CCS_AFTER_HELLO_RETRY_REQUEST, 1)
                             else (0, MBEDTLS_SSL_CLIENT_HELLO, 1)
                            )

ssl_tls13_write_server_hello : (SSL, OT_CONF) -> [32] -> ([32], SSL)
ssl_tls13_write_server_hello (s,ot) mr = (ret,s2)
    where s2 = {state = state' ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = s.handshake,
                conf = s.conf,
                null_flag = s.null_flag
                }
          ret' = mr
          (ret, state') = if ret' != 0 then (ret', s.state)
                          else (
                            if ot.mbedtls_ssl_tls1_3_compatibility_mode == True
                                then(0, MBEDTLS_SSL_SERVER_CCS_AFTER_SERVER_HELLO)
                             else (0, MBEDTLS_SSL_ENCRYPTED_EXTENSIONS)
                            )

ssl_tls13_write_encrypted_extensions : (SSL, OT_CONF) -> [32] -> ([32], SSL)
ssl_tls13_write_encrypted_extensions (s,ot) mr = (ret,s2)
    where s2 = {state = state' ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = s.handshake,
                conf = s.conf,
                null_flag = s.null_flag
                }
          ret' = mr
          (ret, state') = if ret' != 0 then (ret', s.state)
                          else (
                            // if ot.mbedtls_ssl_tls1_3_compatibility_mode == True
                            //     then if s.handshake.key_exchange_mode && MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ALL != 0
                                  if s.handshake.key_exchange_mode && MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ALL != 0
                                    then(0, MBEDTLS_SSL_SERVER_FINISHED)
                                else (0, MBEDTLS_SSL_CERTIFICATE_REQUEST)
                            //  else (0, MBEDTLS_SSL_SERVER_FINISHED)
                            )

ssl_tls13_write_certificate_request : SSL -> [32] -> ([32], SSL)
ssl_tls13_write_certificate_request s mr = (ret,s2)
    where s2 = {state = state' ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = s.handshake,
                conf = s.conf,
                null_flag = s.null_flag
                }
          ret' = mr
          (ret, state') = if ret' == SSL_CERTIFICATE_REQUEST_SEND_REQUEST \/ ret' == SSL_CERTIFICATE_REQUEST_SKIP
                            then (0, MBEDTLS_SSL_SERVER_CERTIFICATE)
                          else (MBEDTLS_ERR_SSL_INTERNAL_ERROR, s.state)

ssl_tls13_write_server_certificate : (SSL, OT_CONF) -> [32] -> [32] -> ([32], SSL)
ssl_tls13_write_server_certificate (s,ot) mr pick_key = (ret,s2)
    where s2 = {state = state' ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = s.handshake,
                conf = s.conf,
                null_flag = s.null_flag
                }
          ret' = mr
          (ret, state') = if ot.mbedtls_x509_crt_parse_c == True /\ ( pick_key != 0 \/ ot.anon_empty == NULL) //pick_key 1
                            then (MBEDTLS_ERR_SSL_HANDSHAKE_FAILURE, s.state)
                          else if ret' != 0 then (ret', s.state)
                          else (0, MBEDTLS_SSL_CERTIFICATE_VERIFY)

ssl_tls13_write_certificate_verify : SSL -> [32] -> ([32], SSL)
ssl_tls13_write_certificate_verify s mr = (ret, s2)
    where s2 = {state = state' ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = s.handshake,
                conf = s.conf,
                null_flag = s.null_flag
                }
          ret' = mr
          (ret, state') = if ret' != 0
                            then (ret', s.state)
                          else (0, MBEDTLS_SSL_SERVER_FINISHED)

mbedtls_ssl_tls13_write_change_cipher_spec : SSL -> [32] -> ([32], SSL)
mbedtls_ssl_tls13_write_change_cipher_spec s mr = (ret,s2)
    where s2 = {state = s.state ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = {min_tls_version = s.handshake.min_tls_version,
                             hello_retry_request_flag = s.handshake.hello_retry_request_flag,
                             key_exchange_mode = s.handshake.key_exchange_mode,
                             client_auth = s.handshake.client_auth,
                             ccs_sent = ccs_sent',
                             certificate_request_sent = s.handshake.certificate_request_sent,
                             tls13_kex_modes = s.handshake.tls13_kex_modes,
                             new_session_tickets_count = s.handshake.new_session_tickets_count,
                             received_extensions = s.handshake.received_extensions,
                             early_data_accepted = s.handshake.early_data_accepted
                            },
                conf = s.conf,
                null_flag = s.null_flag
                }
          ret' = mr
          (ret,ccs_sent') = if s.handshake.ccs_sent != (0:[8]) then (0, s.handshake.ccs_sent)
                          else if ret' != 0 then (ret', s.handshake.ccs_sent)
                          else (0, MBEDTLS_SSL_MSG_CHANGE_CIPHER_SPEC)

ssl_tls13_write_server_finished : (SSL, OT_CONF) -> [32] -> ([32], SSL)
ssl_tls13_write_server_finished (s, ot) mr = (ret, s2)
    where s2 = {state = state' ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = s.handshake,
                conf = s.conf,
                null_flag = s.null_flag
                }
          ret' = mr
          (ret, state') = if ret' != 0
                            then (ret', s.state)
                          else if ( ot.mbedtls_ssl_early_data == True /\ s.handshake.early_data_accepted != (0:[8]) )
                            then (0, MBEDTLS_SSL_END_OF_EARLY_DATA)
                          else (
                            if s.handshake.certificate_request_sent != 0
                                then (0, MBEDTLS_SSL_CLIENT_CERTIFICATE)
                            else (0, MBEDTLS_SSL_CLIENT_FINISHED)
                          ) 
 
ssl_tls13_process_client_finished : SSL -> [32] -> ([32], SSL)
ssl_tls13_process_client_finished s mr = (ret, s2)
    where s2 = {state = state' ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = s.handshake,
                conf = s.conf,
                null_flag = s.null_flag
                }
          ret' = mr
          (ret, state') = if ret' != 0
                            then (ret', s.state)
                          else (0, MBEDTLS_SSL_HANDSHAKE_WRAPUP)

ssl_tls13_handshake_wrapup : (SSL, OT_CONF) -> ([32], SSL)
ssl_tls13_handshake_wrapup (s,ot) = (ret, s2)
    where s2 = {state = state' ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = s.handshake,
                conf = s.conf,
                null_flag = s.null_flag
                }
          (ret, state') = if ot.mbedtls_ssl_session_tickets /\ ot.mbedtls_ssl_tls1_3_key_exchange_mode_some_psk_enabled
                            then if s.handshake.tls13_kex_modes && MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ALL != 0
                                    then (0, MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET)
                                else (0, MBEDTLS_SSL_HANDSHAKE_OVER)
                          else (0, MBEDTLS_SSL_HANDSHAKE_OVER)

mbedtls_ssl_tls13_process_certificate : SSL -> [32] -> ([32], SSL)
mbedtls_ssl_tls13_process_certificate s mr = (ret, s2)
    where s2 = {state = state' ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = s.handshake,
                conf = s.conf,
                null_flag = s.null_flag
                }
          ret' = mr
          (ret, state') = (ret', s.state)

mbedtls_ssl_tls13_process_certificate_verify : (SSL, OT_CONF) -> [32] -> ([32], SSL)
mbedtls_ssl_tls13_process_certificate_verify (s,ot) mr = (ret, s2)
    where s2 = {state = state' ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = s.handshake,
                conf = s.conf,
                null_flag = s.null_flag
                }
          ret' = mr
          (ret, state') = if ot.mbedtls_ssl_tls1_3_key_exchange_mode_ephemeral_enabled == True
                            then (ret', s.state)
                          else (MBEDTLS_ERR_SSL_INTERNAL_ERROR, s.state)

ssl_tls13_write_new_session_ticket : SSL -> ([32], SSL)
ssl_tls13_write_new_session_ticket s = (ret, s2)
    where s2 = {state = state' ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = {min_tls_version = s.handshake.min_tls_version,
                             hello_retry_request_flag = s.handshake.hello_retry_request_flag,
                             key_exchange_mode = s.handshake.key_exchange_mode,
                             client_auth = s.handshake.client_auth,
                             ccs_sent = s.handshake.ccs_sent,
                             certificate_request_sent = s.handshake.certificate_request_sent,
                             tls13_kex_modes = s.handshake.tls13_kex_modes,
                             new_session_tickets_count = nstc',
                             received_extensions = s.handshake.received_extensions,
                             early_data_accepted = s.handshake.early_data_accepted
                            },
                conf = s.conf,
                null_flag = s.null_flag
                }
          ret' = ssl_tls13_write_new_session_ticket_coordinate s
          nstc = s.handshake.new_session_tickets_count
          (ret, state', nstc') = if ret' <$ 0 then (ret', s.state, nstc)
                          else if ret' == SSL_NEW_SESSION_TICKET_WRITE //1
                            then (ret', MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET_FLUSH, nstc-1)
                          else (ret', MBEDTLS_SSL_HANDSHAKE_OVER, nstc)

ssl_tls13_write_new_session_ticket_coordinate : SSL -> [32]
ssl_tls13_write_new_session_ticket_coordinate s = if s.conf.f_ticket_write == NULL \/ s.conf.new_session_tickets_count == 0 \/ s.handshake.new_session_tickets_count == 0
                                                    then SSL_NEW_SESSION_TICKET_SKIP //0
                                                  else SSL_NEW_SESSION_TICKET_WRITE //1

ssl_tls13_process_end_of_early_data : SSL -> [32] -> ([32], SSL)
ssl_tls13_process_end_of_early_data s mr = (ret, s2)
    where s2 = {state = state' ,
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = s.handshake,
                conf = s.conf,
                null_flag = s.null_flag
                }
          ret' = mr
          (ret, state') = if ret' == SSL_GOT_END_OF_EARLY_DATA
                            then if s.handshake.certificate_request_sent != 0
                              then (0, MBEDTLS_SSL_CLIENT_CERTIFICATE)
                            else (0, MBEDTLS_SSL_CLIENT_FINISHED)
                          else if ret' == SSL_GOT_EARLY_DATA
                            then (MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA, s.state)
                          else (MBEDTLS_ERR_SSL_INTERNAL_ERROR, s.state)

valid_mbedtls_ssl_tls13_handshake_server_step : (SSL, OT_CONF) -> ([32], SSL)
valid_mbedtls_ssl_tls13_handshake_server_step (s, ot) = (ret,s2)
    where s2 = {state = state',
                early_data_state = s.early_data_state ,
                tls_version = s.tls_version ,
                handshake = {min_tls_version = s.handshake.min_tls_version,
                             hello_retry_request_flag = hello_retry_request_flag',
                             key_exchange_mode = s.handshake.key_exchange_mode,
                             client_auth = s.handshake.client_auth,
                             ccs_sent = ccs_sent',
                             certificate_request_sent = s.handshake.certificate_request_sent,
                             tls13_kex_modes = s.handshake.tls13_kex_modes,
                             new_session_tickets_count = nstc',
                             received_extensions = s.handshake.received_extensions,
                             early_data_accepted = s.handshake.early_data_accepted
                            },
                conf = s.conf,
                null_flag = s.null_flag
                }

          hello_retry_request_flag' = if s.state == MBEDTLS_SSL_HELLO_RETRY_REQUEST
                                        then (ssl_tls13_write_hello_retry_request (s,ot) 0).1.handshake.hello_retry_request_flag
                                      else s.handshake.hello_retry_request_flag
          ccs_sent' = if MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE == True /\ 
                    (s.state == MBEDTLS_SSL_SERVER_CCS_AFTER_HELLO_RETRY_REQUEST \/ s.state == MBEDTLS_SSL_SERVER_CCS_AFTER_SERVER_HELLO)
                    then (mbedtls_ssl_tls13_write_change_cipher_spec s 0).1.handshake.ccs_sent
                  else s.handshake.ccs_sent
          nstc' = if ot.mbedtls_ssl_session_tickets == True /\ s.state == MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET
                    then (ssl_tls13_write_new_session_ticket s).1.handshake.new_session_tickets_count
                  else s.handshake.new_session_tickets_count
          (ret, state') = if s.state == MBEDTLS_SSL_HANDSHAKE_OVER \/ s.null_flag.handshake_flag == False
                            then (MBEDTLS_ERR_SSL_BAD_INPUT_DATA, s.state)
                          else if s.state == MBEDTLS_SSL_HELLO_REQUEST
                            then (0, MBEDTLS_SSL_CLIENT_HELLO)
                          else if s.state == MBEDTLS_SSL_CLIENT_HELLO
                            then ((ssl_tls13_process_client_hello s ot.amr).0, (ssl_tls13_process_client_hello s ot.amr).1.state)
                          else if s.state == MBEDTLS_SSL_HELLO_RETRY_REQUEST
                            then ((ssl_tls13_write_hello_retry_request (s,ot) 0).0, (ssl_tls13_write_hello_retry_request (s,ot) 0).1.state)
                          else if s.state == MBEDTLS_SSL_SERVER_HELLO
                            then ((ssl_tls13_write_server_hello (s,ot) 0).0, (ssl_tls13_write_server_hello (s,ot) 0).1.state)
                          else if s.state == MBEDTLS_SSL_ENCRYPTED_EXTENSIONS
                            then ((ssl_tls13_write_encrypted_extensions (s,ot) 0).0, (ssl_tls13_write_encrypted_extensions (s,ot) 0).1.state)
                          else if ot.mbedtls_ssl_tls1_3_key_exchange_mode_ephemeral_enabled == True /\ s.state == MBEDTLS_SSL_CERTIFICATE_REQUEST
                            then ((ssl_tls13_write_certificate_request s 0).0, (ssl_tls13_write_certificate_request s 0).1.state)
                          else if ot.mbedtls_ssl_tls1_3_key_exchange_mode_ephemeral_enabled == True /\ s.state == MBEDTLS_SSL_SERVER_CERTIFICATE
                            then ((ssl_tls13_write_server_certificate (s,ot) 0 1).0, (ssl_tls13_write_server_certificate (s,ot) 0 1).1.state)
                          else if ot.mbedtls_ssl_tls1_3_key_exchange_mode_ephemeral_enabled == True /\ s.state == MBEDTLS_SSL_CERTIFICATE_VERIFY
                            then ((ssl_tls13_write_certificate_verify s 0).0, (ssl_tls13_write_certificate_verify s 0).1.state)
                          else if ot.mbedtls_ssl_tls1_3_compatibility_mode == True /\ s.state == MBEDTLS_SSL_SERVER_CCS_AFTER_HELLO_RETRY_REQUEST
                            then if (mbedtls_ssl_tls13_write_change_cipher_spec s 0).0 == 0
                              then (0, MBEDTLS_SSL_CLIENT_HELLO)
                            else ((mbedtls_ssl_tls13_write_change_cipher_spec s 0).0, s.state)
                          else if ot.mbedtls_ssl_tls1_3_compatibility_mode == True /\ s.state == MBEDTLS_SSL_SERVER_CCS_AFTER_SERVER_HELLO
                            then if (mbedtls_ssl_tls13_write_change_cipher_spec s 0).0 != 0
                              then ((mbedtls_ssl_tls13_write_change_cipher_spec s 0).0, s.state)
                            else (0, MBEDTLS_SSL_ENCRYPTED_EXTENSIONS)
                          else if s.state == MBEDTLS_SSL_SERVER_FINISHED
                            then ((ssl_tls13_write_server_finished (s,ot) 0).0, (ssl_tls13_write_server_finished (s,ot) 0).1.state)
                          else if ot.mbedtls_ssl_early_data == True /\ s.state == MBEDTLS_SSL_END_OF_EARLY_DATA
                            then ((ssl_tls13_process_end_of_early_data s 0).0, (ssl_tls13_process_end_of_early_data s 0).1.state) ///todo
                          else if s.state == MBEDTLS_SSL_CLIENT_FINISHED
                            then ((ssl_tls13_process_client_finished s 0).0, (ssl_tls13_process_client_finished s 0).1.state)
                          else if s.state == MBEDTLS_SSL_HANDSHAKE_WRAPUP
                            then ((ssl_tls13_handshake_wrapup (s,ot) ).0, (ssl_tls13_handshake_wrapup (s,ot) ).1.state)
                          else if ot.mbedtls_ssl_tls1_3_key_exchange_mode_ephemeral_enabled == True /\ s.state == MBEDTLS_SSL_CLIENT_CERTIFICATE
                            then if (mbedtls_ssl_tls13_process_certificate s 0).0 == 0
                              then if s.null_flag.peer_cert_flag == True
                                then (0, MBEDTLS_SSL_CLIENT_CERTIFICATE_VERIFY)
                              else (0, MBEDTLS_SSL_CLIENT_FINISHED)
                            else ((mbedtls_ssl_tls13_process_certificate s 0).0, s.state)
                          else if ot.mbedtls_ssl_tls1_3_key_exchange_mode_ephemeral_enabled == True /\ s.state == MBEDTLS_SSL_CLIENT_CERTIFICATE_VERIFY
                            then if (mbedtls_ssl_tls13_process_certificate_verify (s,ot) 0).0 == 0
                              then (0, MBEDTLS_SSL_CLIENT_FINISHED)
                            else ((mbedtls_ssl_tls13_process_certificate_verify (s,ot) 0).0, s.state)
                          else if ot.mbedtls_ssl_session_tickets == True /\ s.state == MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET
                            then ((ssl_tls13_write_new_session_ticket s).0, (ssl_tls13_write_new_session_ticket s).1.state)
                          else if ot.mbedtls_ssl_session_tickets == True /\ s.state == MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET_FLUSH
                            then if s.handshake.new_session_tickets_count == 0
                              then (0,MBEDTLS_SSL_HANDSHAKE_OVER)
                            else (0, MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET)
                          else (MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE, s.state)

mbedtls_ssl_handshake_step : (SSL, OT_CONF) -> ([32], SSL)
mbedtls_ssl_handshake_step (s,ot) =
                        if s.null_flag.conf_flag == False \/ s.null_flag.handshake_flag == False \/ s.state == MBEDTLS_SSL_HANDSHAKE_OVER
                            then (MBEDTLS_ERR_SSL_BAD_INPUT_DATA, s)
                        // else if MBEDTLS_SSL_CLI_C == True /\ s.conf.endpoint == MBEDTLS_SSL_IS_CLIENT
                        //     then ((valid_mbedtls_ssl_tls13_handshake_client_step (s,ot)).0, (valid_mbedtls_ssl_tls13_handshake_client_step (s,ot)).1)
                        else if MBEDTLS_SSL_SRV_C == True /\ s.conf.endpoint == MBEDTLS_SSL_IS_SERVER
                            then ((valid_mbedtls_ssl_tls13_handshake_server_step (s,ot)).0, (valid_mbedtls_ssl_tls13_handshake_server_step (s,ot)).1)
                        else (MBEDTLS_ERR_SSL_BAD_INPUT_DATA, s)

mbedtls_ssl_handshake : {n} (fin n, n >= 1) => (SSL, OT_CONF) -> [n]SSL
mbedtls_ssl_handshake (s,ot) = take`{n}sandot.0
    where 
        sandot = [(s, ot)] # 
                      [if m.state != MBEDTLS_SSL_HANDSHAKE_OVER /\ (mbedtls_ssl_handshake_step (m,ot)).0 == 0 
                        then if m.state == MBEDTLS_SSL_HELLO_RETRY_REQUEST
                          then ((mbedtls_ssl_handshake_step (m, n)).1, updateOT_CONF) 
                        else ((mbedtls_ssl_handshake_step (m, n)).1, n) 
                      else (emptyState m, n)
                      | (m, n) <- sandot]
        updateOT_CONF = {
            mbedtls_ssl_tls1_3_compatibility_mode = ot.mbedtls_ssl_tls1_3_compatibility_mode,
            mbedtls_ssl_early_data = ot.mbedtls_ssl_early_data,
            mbedtls_ssl_session_tickets = ot.mbedtls_ssl_session_tickets,
            mbedtls_ssl_tls1_3_key_exchange_mode_ephemeral_enabled = True,
            mbedtls_x509_crt_parse_c = False,
            mbedtls_ssl_tls1_3_key_exchange_mode_some_psk_enabled = True,
            amr = 0,
            anon_empty = ot.anon_empty
        }
        emptyState m = {
        state = MBEDTLS_EMPTY,
        early_data_state = m.early_data_state,
        tls_version = m.tls_version,
        handshake = m.handshake,
        conf = m.conf,
        null_flag = m.null_flag
        } 

